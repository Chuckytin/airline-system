# ============================================
# Maven Wrapper
# ============================================
/mvnw text eol=lf
*.cmd text eol=crlf

# ============================================
# Normalización general
# ============================================
* text=auto eol=lf

# ============================================
# Scripts
# ============================================
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# ============================================
# Archivos binarios
# ============================================
*.jar binary
*.war binary
*.class binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.xlsx binary
*.docx binary
*.pptx binary

# ============================================
# Archivos de configuración (siempre LF)
# ============================================
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf

# ============================================
# Git
# ============================================
.gitattributes text
.gitignore text

# ============================================
# Excluir del ZIP de GitHub
# ============================================
.github/ export-ignore
.gitignore export-ignore
.gitattributes export-ignore
.editorconfig export-ignore